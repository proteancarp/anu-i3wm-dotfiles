configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "Apps";
    drun-display-format: "{name}";
    font: "Noto Sans Mono 10";
}

* {
    background: #11191c;
    foreground: #c8d1d5;
    selected-background: #8aa3a5;
    selected-foreground: #11191c;

    border-color: #657f91;
    separatorcolor: #46565b;
    accent: #657f91;

    spacing: 8px;
}

window {
    width: 520px;
    border: 1px;
    border-radius: 8px;
    padding: 18px;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
    background-color: @background;
}

inputbar {
    padding: 8px 12px;
    border: 1px;
    border-radius: 6px;
    border-color: #46565b;
    background-color: #182326;
    text-color: @foreground;
    children: [ prompt, entry ];
}

prompt {
    text-color: #657f91;
    padding: 0 8px 0 0;
}

entry {
    text-color: @foreground;
    placeholder: "Search applications...";
    placeholder-color: #657f91;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
    background-color: @background;
}

element {
    padding: 9px 12px;
    border-radius: 5px;
    background-color: @background;
    text-color: @foreground;
}

element normal.normal {
    background-color: @background;
    text-color: @foreground;
}

element alternate.normal {
    background-color: @background;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

configuration {
    font: "Noto Sans Mono 10";
    show-icons: false;
    disable-history: true;
}

* {
    bg: #11191c;
    bg-alt: #182326;
    fg: #c8d1d5;
    fg-muted: #657f91;
    accent: #8aa3a5;
    accent-fg: #11191c;
    border: #46565b;
}

window {
    width: 320px;
    background-color: @bg;
    border: 1px;
    border-color: @border;
    padding: 16px;
}

mainbox {
    background-color: @bg;
    children: [listview];
}

listview {
    background-color: @bg;
    lines: 5;
    columns: 1;
    spacing: 3px;
    scrollbar: false;
    fixed-height: true;
}

element {
    background-color: @bg;
    text-color: @fg;
    padding: 10px 14px;
}

element normal {
    background-color: @bg;
    text-color: @fg;
}

element alternate {
    background-color: @bg;
    text-color: @fg;
}

element selected {
    background-color: @accent;
    text-color: @accent-fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

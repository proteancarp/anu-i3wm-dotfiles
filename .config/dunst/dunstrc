[global]
    # ─────────────────────────────────────────
    # proteancarp — Dunst
    # ─────────────────────────────────────────

    monitor = 0

    follow = mouse

    width = 360
    height = 120

    origin = top-right
    offset = 20x20

    notification_limit = 5

    font = Noto Sans Mono 10

    frame_width = 1
    separator_height = 2

    padding = 12
    horizontal_padding = 14

    corner_radius = 8

    transparency = 8

    format = "<b>%s</b>\n%b"

    alignment = left

    markup = full

    show_age_threshold = 60

    stack_duplicates = true
    hide_duplicate_count = true

    # Keep notifications quiet
    idle_threshold = 120

[urgency_low]
    background = "#182124"
    foreground = "#aab7bb"
    frame_color = "#46565b"
    timeout = 4

[urgency_normal]
    background = "#182124"
    foreground = "#c8d1d5"
    frame_color = "#6f9291"
    timeout = 6

[urgency_critical]
    background = "#24191b"
    foreground = "#e0e6e7"
    frame_color = "#b77d7d"
    timeout = 0
